<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:Renaissance.UI.Controls"
        xmlns:vm="using:Renaissance.UI.ViewModels"
        x:Class="Renaissance.UI.Views.ParamsWindow"
        Title="{Binding Title}" Width="980" Height="700" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto" Margin="18" RowSpacing="12">

    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
      <TextBox Text="{Binding SearchText}" Watermark="Search parameters…" />
      <ToggleButton Grid.Column="1" Content="Modified Only" IsChecked="{Binding ModifiedOnly}" />
      <ToggleButton Grid.Column="2" Content="Automatable Only" IsChecked="{Binding AutomatableOnly}" />
      <Button Grid.Column="3" Content="Reset Page" Command="{Binding ResetPageCommand}" />
      <Button Grid.Column="4" Content="Reset All" Classes="danger" Command="{Binding ResetAllCommand}" />
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="190,*" ColumnSpacing="14">
      <Border Classes="card" Padding="6">
        <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ParamPage">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Border Grid.Column="1" Classes="card" Padding="10">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Visible}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Width="112" Margin="4" Padding="8,10" CornerRadius="8" Background="{StaticResource Surface2Brush}"
                        ToolTip.Tip="{Binding Tooltip}">
                  <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="12" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                               MaxWidth="96" Classes="muted" />
                    <ctl:DialControl Width="64" Height="64" HorizontalAlignment="Center"
                                     Value="{Binding Value, Mode=TwoWay}" DefaultValue="{Binding DefaultValue}"
                                     IsModified="{Binding IsModified}">
                      <ctl:DialControl.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Reset to default" Command="{Binding ResetCommand}" />
                          <Separator />
                          <MenuItem Header="Set to minimum" Command="{Binding SetMinCommand}" />
                          <MenuItem Header="Set to centre" Command="{Binding SetCenterCommand}" />
                          <MenuItem Header="Set to maximum" Command="{Binding SetMaxCommand}" />
                        </ContextMenu>
                      </ctl:DialControl.ContextMenu>
                    </ctl:DialControl>
                    <TextBlock Text="{Binding Display}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="96" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
    </Grid>

    <TextBlock Grid.Row="2" Text="{Binding CountText}" Classes="muted" FontSize="12" />
  </Grid>
</Window>
