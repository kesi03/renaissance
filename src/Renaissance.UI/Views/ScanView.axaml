<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Renaissance.UI.Views.ScanView">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="20" RowSpacing="14">

    <!-- Folders -->
    <Border Grid.Row="0" Classes="card" Padding="14">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
          <TextBox Grid.Column="0" Text="{Binding NewFolderText}" Watermark="VST Folders — type a path (local or network) or browse…">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding AddFolderCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseFolderCommand}" />
          <Button Grid.Column="2" Content="Add" Command="{Binding AddFolderCommand}" />
          <Button Grid.Column="3" Content="Remove" Classes="danger" Command="{Binding RemoveFolderCommand}" />
        </Grid>
        <ListBox Grid.Row="1" ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}"
                 MaxHeight="84" Background="Transparent" />
      </Grid>
    </Border>

    <!-- Scan toolbar -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
      <Button Content="Scan" Classes="primary" Command="{Binding ScanCommand}" IsEnabled="{Binding IsIdle}" />
      <Button Content="Rescan All" Command="{Binding RescanAllCommand}" IsEnabled="{Binding IsIdle}" />
      <ToggleButton Content="Scan Failed" IsChecked="{Binding FailedOnly, Mode=TwoWay}"
                    ToolTip.Tip="Show only plugins that failed (crashed, warning, missing)" />
      <Button Content="Stop" Classes="danger" Command="{Binding StopCommand}" IsEnabled="{Binding IsScanning}" />
      <Border Width="1" Background="{StaticResource BorderBrushSoft}" Margin="8,2" />
      <CheckBox Content="Test Editors" IsChecked="{Binding TestEditors}" VerticalAlignment="Center"
                ToolTip.Tip="Verify each plugin loads, opens its editor and closes it safely" />
      <CheckBox Content="Hide Popups During Scan" IsChecked="{Binding HidePopups}" VerticalAlignment="Center"
                ToolTip.Tip="Suppress splash screens, activation prompts, registration and nag windows" />
    </StackPanel>

    <!-- Search / filter -->
    <Grid Grid.Row="2" ColumnDefinitions="*,220" ColumnSpacing="10">
      <TextBox Text="{Binding SearchText}" Watermark="Search by name, vendor or category…" />
      <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                HorizontalAlignment="Stretch" />
    </Grid>

    <!-- Progress -->
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <StackPanel Spacing="6">
        <ProgressBar Minimum="0" Maximum="{Binding ProgressMax}" Value="{Binding ProgressValue}"
                     IsVisible="{Binding IsScanning}" Height="4" Foreground="{StaticResource AccentBrush}" />
        <TextBlock Text="{Binding StatusText}" Classes="muted" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <TextBlock Grid.Column="1" Text="{Binding Summary}" Classes="muted" VerticalAlignment="Bottom" />
    </Grid>

    <!-- Grid -->
    <DataGrid Grid.Row="4" x:Name="PluginGrid"
              ItemsSource="{Binding Plugins}" SelectedItem="{Binding SelectedPlugin}"
              AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True" CanUserResizeColumns="True"
              GridLinesVisibility="Horizontal" SelectionMode="Single" RowHeight="34">
      <DataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Load Plugin" Command="{Binding OpenPluginCommand}" />
          <Separator />
          <MenuItem Header="Toggle Favourite" Command="{Binding ToggleFavouriteCommand}" />
          <MenuItem Header="Tags…" Command="{Binding EditTagsCommand}" />
          <MenuItem Header="Custom Icon…" Command="{Binding SetIconCommand}" />
          <Separator />
          <MenuItem Header="Enable / Disable" Command="{Binding ToggleDisabledCommand}" />
          <MenuItem Header="Remove From List" Command="{Binding RemoveFromListCommand}" />
        </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="Name" Width="2*" SortMemberPath="Info.Name">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="10,0" VerticalAlignment="Center">
                <Image Source="{Binding Icon}" Width="20" Height="20" IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="90" />
        <DataGridTextColumn Header="Vendor" Binding="{Binding Vendor}" Width="*" />
        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="110" />
        <DataGridTextColumn Header="Bits" Binding="{Binding Bits}" Width="80" />
        <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="90" />
        <DataGridTemplateColumn Header="Status" Width="110" SortMemberPath="Status">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="10,0" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" />
                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Details" Width="2*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Details}" Classes="muted" Margin="10,0" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Details}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <TextBlock Grid.Row="5" Classes="muted" FontSize="12"
               Text="Double-click a plugin to load it. Right-click for favourites, tags and icons." />
  </Grid>
</UserControl>
