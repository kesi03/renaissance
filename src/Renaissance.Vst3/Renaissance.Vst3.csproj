<Project Sdk="Microsoft.NET.Sdk">
  <!-- Native VST3 plugin module (x64), published with NativeAOT. build-vst2.ps1 packages the result as
       Renaissance.vst3\Contents\x86_64-win\Renaissance.vst3 -->
  <PropertyGroup>
    <AssemblyName>Renaissance.Vst3</AssemblyName>
    <OutputType>Library</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SelfContained>true</SelfContained>
    <StripSymbols>true</StripSymbols>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <NoWarn>$(NoWarn);IL2026;IL3050;IL2104;IL3053</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Renaissance.Core\Renaissance.Core.csproj" />
  </ItemGroup>
</Project>
