<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Renaissance.UI.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <Color x:Key="BgColor">#14161A</Color>
    <SolidColorBrush x:Key="BgBrush" Color="#14161A" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1C1F25" />
    <SolidColorBrush x:Key="Surface2Brush" Color="#242830" />
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#2E333D" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4FD1C5" />
    <SolidColorBrush x:Key="TextBrush" Color="#E6E8EC" />
    <SolidColorBrush x:Key="MutedBrush" Color="#8A92A0" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

    <Style Selector="Window">
      <Setter Property="Background" Value="{StaticResource BgBrush}" />
      <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif" />
    </Style>

    <Style Selector="Button">
      <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="14,7" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="#0C1114" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#7BE3D9" />
      <Setter Property="TextElement.Foreground" Value="#0C1114" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="#FF8A80" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style Selector="DataGrid">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
  </Application.Styles>
</Application>
